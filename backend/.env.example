# Variables de entorno para CanchasApi (.NET Backend)
# En desarrollo local también se pueden gestionar mediante 'dotnet user-secrets'

# Cadena de conexión a Base de Datos (LocalDB o SQL Server)
ConnectionStrings__miconexion="Server=(localdb)\MSSQLLocalDB;Initial Catalog=ReservasCanchasDB;Integrated Security=True;Encrypt=False"

# Clave secreta JWT (Requerida: mínima longitud recomendada de 256 bits / 32+ caracteres)
Jwt__Key="REEMPLAZAR_POR_UNA_CLAVE_SECRETA_LARGA_Y_SEGURA_AQUI"
Jwt__Issuer="CanchasApi"
Jwt__Audience="CanchasApiUsuarios"
Jwt__ExpiraMinutos=60

# Puerto de ejecución
ASPNETCORE_URLS="https://localhost:7098;http://localhost:5098"
ASPNETCORE_ENVIRONMENT="Development"
